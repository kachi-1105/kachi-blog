---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={`${post.data.title} — Kachi Blog`}>
  <article class="post">
    <header class="post-header">
      <div class="post-hero">
        <Image
          src={post.data.image}
          alt={post.data.title}
          width={860}
          height={420}
        />
      </div>
      <div class="post-meta">
        <div class="post-tags">
          {post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
        <h1 class="post-title">{post.data.title}</h1>
        <time class="post-date" datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('ja-JP', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <p class="post-desc">{post.data.description}</p>
      </div>
    </header>

    <div class="post-content">
      <Content />
    </div>

    <div class="back-link">
      <a href="/">← 記事一覧へ戻る</a>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 740px;
    margin: 0 auto;
  }

  .post-header {
    border-bottom: 2px solid #eee;
    margin-bottom: 2rem;
    padding-bottom: 1.2rem;
  }

  .post-hero {
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 1.2rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }

  .post-hero img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
  }

  .tag {
    background: #eef4ff;
    color: #4f8ef7;
    font-size: 0.75rem;
    padding: 0.2rem 0.65rem;
    border-radius: 100px;
    font-weight: 600;
  }

  .post-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: #111;
    line-height: 1.35;
    letter-spacing: -0.02em;
    margin-bottom: 0.4rem;
  }

  .post-date {
    font-size: 0.82rem;
    color: #999;
    display: block;
    margin-bottom: 0.6rem;
  }

  .post-desc {
    font-size: 0.95rem;
    color: #555;
    border-left: 3px solid #4f8ef7;
    padding-left: 0.85rem;
    margin-bottom: 0;
    line-height: 1.65;
  }

  .post-content {
    line-height: 1.9;
    color: #333;
    font-size: 1.02rem;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    color: #111;
    margin-top: 2.2rem;
    margin-bottom: 0.8rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .post-content :global(h2) {
    font-size: 1.45rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid #eee;
  }

  .post-content :global(h3) {
    font-size: 1.2rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.3rem;
  }

  .post-content :global(img) {
    max-width: 100%;
    border-radius: 10px;
    margin: 1.5rem 0;
    display: block;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1rem 0 1.3rem 1.6rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.45rem;
  }

  .post-content :global(strong) {
    color: #111;
    font-weight: 700;
  }

  .post-content :global(a) {
    color: #4f8ef7;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid #4f8ef7;
    padding: 0.5rem 1rem;
    background: #f0f6ff;
    border-radius: 0 8px 8px 0;
    margin: 1.5rem 0;
    color: #555;
  }

  .post-content :global(code) {
    background: #f0f4f8;
    padding: 0.15em 0.45em;
    border-radius: 4px;
    font-size: 0.87em;
    font-family: 'Fira Code', 'Consolas', monospace;
    color: #d63384;
  }

  .post-content :global(pre) {
    background: #1e1e2e;
    color: #cdd6f4;
    padding: 1.3rem 1.5rem;
    border-radius: 10px;
    overflow-x: auto;
    margin: 1.8rem 0;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  .back-link {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #eee;
  }

  .back-link a {
    color: #4f8ef7;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .back-link a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 600px) {
    .post-title {
      font-size: 1.35rem;
    }

    .post-hero img {
      height: 150px;
    }
  }
</style>
