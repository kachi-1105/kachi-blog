---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return [
    { params: { category: 'tech' },  props: { label: '技術',  tag: '技術' } },
    { params: { category: 'daily' }, props: { label: '日常',  tag: '日常' } },
  ];
}

const { label, tag } = Astro.props;

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => post.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`${label} — Kachi Blog`}>
  <div class="category-header">
    <h1 class="page-title">{label}</h1>
    <span class="post-count">{posts.length}件</span>
  </div>

  {posts.length === 0 && (
    <p class="empty">「{tag}」タグの記事がまだありません。</p>
  )}

  <div class="post-list">
    {posts.map((post) => (
      <article class="post-card">
        <a href={`${import.meta.env.BASE_URL}blog/${post.slug}`} class="post-link">
          <div class="post-image">
            <Image
              src={post.data.image}
              alt={post.data.title}
              width={260}
              height={160}
            />
          </div>
          <div class="post-body">
            <time class="post-date" datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('ja-JP', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <h2 class="post-title">{post.data.title}</h2>
            <p class="post-desc">{post.data.description}</p>
            <div class="post-tags">
              {post.data.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </div>
        </a>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .category-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #eef4ff;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #111;
    letter-spacing: -0.02em;
  }

  .post-count {
    font-size: 0.85rem;
    color: #aaa;
    font-weight: 500;
  }

  .empty {
    color: #888;
    text-align: center;
    padding: 4rem;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-card {
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    transition: box-shadow 0.25s, transform 0.25s;
    border: 1px solid #eee;
  }

  .post-card:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,0.11);
    transform: translateY(-2px);
  }

  .post-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: stretch;
  }

  .post-image {
    flex-shrink: 0;
    width: 220px;
    background: #e8e8e8;
    overflow: hidden;
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }

  .post-card:hover .post-image img {
    transform: scale(1.04);
  }

  .post-body {
    padding: 1.4rem 1.6rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    flex: 1;
  }

  .post-date {
    font-size: 0.78rem;
    color: #aaa;
    display: block;
  }

  .post-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #111;
    line-height: 1.5;
  }

  .post-card:hover .post-title {
    color: #2563eb;
  }

  .post-desc {
    font-size: 0.875rem;
    color: #666;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.65;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .tag {
    background: #eef4ff;
    color: #4f8ef7;
    font-size: 0.72rem;
    padding: 0.18rem 0.6rem;
    border-radius: 100px;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .post-link {
      flex-direction: column;
    }

    .post-image {
      width: 100%;
      height: 180px;
    }

    .post-body {
      padding: 1.1rem 1.2rem;
    }

    .post-title {
      font-size: 1rem;
    }
  }
</style>
